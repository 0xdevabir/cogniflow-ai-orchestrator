# ── CogniFlow environment template ──
# Copy to `.env` and fill in real keys. Never commit `.env`.

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:8080
NEXT_PUBLIC_ML_GATEWAY_BASE=http://localhost:8081

# --- Orchestrator (Go) ---
ORCH_PORT=8080
ORCH_ML_GATEWAY_URL=http://localhost:8081
ORCH_DATABASE_URL=postgres://cogniflow:cogniflow@localhost:5432/cogniflow?sslmode=disable
ORCH_REDIS_URL=redis://localhost:6379
ORCH_QDRANT_URL=http://localhost:6333

# Model provider keys — only fill what you have; rest gracefully no-op.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
HF_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- ML Gateway (Python) ---
ML_GATEWAY_PORT=8081
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Observability (Phase 8) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=